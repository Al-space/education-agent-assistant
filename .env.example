# ============================================================
# 教育智能题库助手 - 环境变量示例
# 使用方法：复制为 .env 后填入真实值，禁止把 .env 提交到仓库
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# ============================================================

# ---------- 模型服务（SiliconFlow，OpenAI 兼容接口） ----------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 对话模型
LLM_MODEL=
# 向量模型
EMBEDDING_MODEL=

# ---------- 联网搜索 ----------
SERPAPI_API_KEY=

# ---------- 天气查询（心知天气） ----------
SENIVERSE_API_KEY=

# ---------- 数据存储 ----------
DATABASE_URL=sqlite:///./education_assistant.db
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/indexes
GENERATED_DIR=./generated

# ---------- RAG 参数 ----------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5

# ---------- 服务运行 ----------
API_HOST=127.0.0.1
API_PORT=6605
GRADIO_PORT=7860
MAX_UPLOAD_MB=50
AGENT_MAX_ITERATIONS=6
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO

# ---------- 代码解释器（可选） ----------
CODEBOX_API_KEY=
