# ============================================================
# 教育智能题库助手 - Git 忽略规则
# ============================================================

# ---------- 密钥与本地配置 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
ENV/

# ---------- 测试与类型检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------- 运行时数据（保留目录占位文件） ----------
data/uploads/*
!data/uploads/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
generated/*
!generated/.gitkeep
*.db
*.sqlite
*.sqlite3
*.db-journal
faiss.index
*.faiss

# ---------- 日志 ----------
logs/
*.log

# ---------- 编辑器与 IDE ----------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时文件与 Notebook ----------
*.tmp
*.bak
.ipynb_checkpoints/
